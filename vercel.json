{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tt-analysis.vercel.app"
        }
      ],
      "destination": "https://ttanalysis.app/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "tt-analysis.vercel.app"
        }
      ],
      "destination": "https://ttanalysis.app/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/help",
      "destination": "/help/index.html"
    },
    {
      "source": "/help/first-match",
      "destination": "/help/first-match.html"
    },
    {
      "source": "/help/tracker",
      "destination": "/help/tracker.html"
    },
    {
      "source": "/help/unforced-errors-and-attacks",
      "destination": "/help/unforced-errors-and-attacks.html"
    },
    {
      "source": "/help/fix-a-point",
      "destination": "/help/fix-a-point.html"
    },
    {
      "source": "/help/someone-else",
      "destination": "/help/someone-else.html"
    },
    {
      "source": "/help/sharing",
      "destination": "/help/sharing.html"
    },
    {
      "source": "/help/glossary",
      "destination": "/help/glossary.html"
    },
    {
      "source": "/help/keyboard-shortcuts",
      "destination": "/help/keyboard-shortcuts.html"
    },
    {
      "source": "/help/analysis-page",
      "destination": "/help/analysis-page.html"
    },
    {
      "source": "/help/player-history",
      "destination": "/help/player-history.html"
    },
    {
      "source": "/help/two-shots",
      "destination": "/help/two-shots.html"
    },
    {
      "source": "/help/coach-summary",
      "destination": "/help/coach-summary.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
